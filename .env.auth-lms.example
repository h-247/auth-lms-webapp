# Local-only Auth + LMS stack. Copy to .env.auth-lms.local before running.
AUTH_DB_NAME=auth_lms
AUTH_DB_USER=auth_lms
AUTH_DB_PASSWORD=change-me-auth-db
AUTH_DB_PORT=5433

LMS_DB_NAME=lms
LMS_DB_USER=lms
LMS_DB_PASSWORD=change-me-lms-db
LMS_DB_PORT=5434

REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

JWT_SECRET=change-me-with-at-least-32-characters
LMS_SYNC_SECRET=change-me-lms-sync
NEXTAUTH_SECRET=change-me-with-at-least-32-characters

ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=change-me-admin-password
TEACHER_EMAIL=teacher@example.local
TEACHER_PASSWORD=change-me-teacher-password
STUDENT_EMAIL=student@example.local
STUDENT_PASSWORD=change-me-student-password

FRONTEND_PORT=3000
AUTH_PORT=8080
LMS_PORT=8081
